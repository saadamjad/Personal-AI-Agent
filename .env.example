# Copy to .env for local dev — never commit .env
#   cp .env.example .env

ENVIRONMENT=development
PORT=8000

# ── LLM (pick OpenAI OR Anthropic) ───────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Force a specific provider when both keys are set. Leave empty to auto-detect
# (OpenAI preferred if both are present). Must be exactly "openai" or "anthropic".
CHAT_LLM_PROVIDER=

# ── Safety / cost controls ───────────────────────────────────────────────────
CHAT_MAX_LLM_CALLS_PER_DAY=300
CHAT_MAX_MESSAGE_LENGTH=2000
CHAT_MAX_BODY_BYTES=8192
CHAT_FLOW_TIMEOUT_SECONDS=25

# ── Rate limiting (per 10-minute sliding window) ─────────────────────────────
RATE_LIMIT_PER_SESSION_PER_10MIN=20
RATE_LIMIT_PER_IP_PER_10MIN=40

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Storage ───────────────────────────────────────────────────────────────────
DATABASE_PATH=./data/conversations.db
